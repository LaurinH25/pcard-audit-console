{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pcard-audit-console",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["app.py"],
      "port": 5000
    },
    {
      "name": "pcard-static-pages",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "docs"],
      "port": 8080
    },
    {
      "name": "pcard-streamlit",
      "runtimeExecutable": "streamlit_app\\.venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "streamlit_app/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
